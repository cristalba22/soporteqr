generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRADOR
  TECNICO
  EMPLEADO
}

enum TicketStatus {
  NUEVO
  ASIGNADO
  EN_PROGRESO
  ESPERANDO_USUARIO
  RESUELTO
  CERRADO
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum TicketImpact {
  PERSONA
  SECTOR
  ORGANIZACION
}

enum AssetStatus {
  ACTIVO
  EN_REPARACION
  DE_BAJA
  EN_DEPOSITO
}

enum NotificationType {
  TICKET_CREADO
  TICKET_ASIGNADO
  TICKET_CAMBIO_ESTADO
  TICKET_COMENTARIO
  TICKET_RESUELTO
}

model Organization {
  id        String   @id @default(uuid())
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  locations  Location[]
  categories Category[]
  assets     Asset[]
  tickets    Ticket[]
  auditLogs  AuditLog[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  nombre         String
  email          String   @unique
  passwordHash   String
  role           UserRole
  activo         Boolean  @default(true)
  locationId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id])

  ticketsReportados Ticket[]        @relation("TicketReportante")
  ticketsAsignados  Ticket[]        @relation("TicketTecnico")
  comentarios       TicketComment[]
  historiales       TicketHistory[]
  notificaciones    Notification[]
  auditLogs         AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model Location {
  id             String   @id @default(uuid())
  organizationId String
  nombre         String
  direccion      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  assets       Asset[]
  tickets      Ticket[]

  @@index([organizationId])
  @@map("locations")
}

model Category {
  id             String   @id @default(uuid())
  organizationId String
  nombre         String
  descripcion    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@index([organizationId])
  @@map("categories")
}

model Asset {
  id                  String      @id @default(uuid())
  organizationId      String
  codigoInterno       String
  publicAssetCode     String      @unique
  tipo                String
  marca               String?
  modelo              String?
  numeroSerie         String?
  locationId          String
  estado              AssetStatus @default(ACTIVO)
  fechaAdquisicion    DateTime?
  notas               String?
  ultimoMantenimiento DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id])
  tickets      Ticket[]

  @@unique([organizationId, codigoInterno])
  @@index([organizationId])
  @@map("assets")
}

model Ticket {
  id                   String         @id @default(uuid())
  organizationId       String
  numero               String         @unique
  titulo               String
  descripcion          String
  assetId              String
  reporterId           String
  technicianId         String?
  categoryId           String?
  locationId           String
  prioridad            TicketPriority @default(MEDIA)
  prioridadCalculada   TicketPriority @default(MEDIA)
  prioridadMotivo      String?
  triageVersion        String         @default("rules-v1")
  impacto              TicketImpact   @default(PERSONA)
  servicioInterrumpido Boolean        @default(false)
  tieneAlternativa     Boolean        @default(true)
  riesgoSeguridad      Boolean        @default(false)
  estado               TicketStatus   @default(NUEVO)
  diagnostico          String?
  solucion             String?
  createdAt            DateTime       @default(now())
  primeraRespuestaAt   DateTime?
  resueltoAt           DateTime?
  cerradoAt            DateTime?
  updatedAt            DateTime       @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset          Asset              @relation(fields: [assetId], references: [id])
  reportante     User               @relation("TicketReportante", fields: [reporterId], references: [id])
  tecnico        User?              @relation("TicketTecnico", fields: [technicianId], references: [id])
  categoria      Category?          @relation(fields: [categoryId], references: [id])
  location       Location           @relation(fields: [locationId], references: [id])
  comentarios    TicketComment[]
  adjuntos       TicketAttachment[]
  historial      TicketHistory[]
  notificaciones Notification[]

  @@index([organizationId])
  @@index([estado])
  @@index([technicianId])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  contenido String
  interno   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketAttachment {
  id          String   @id @default(uuid())
  ticketId    String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketHistory {
  id             String        @id @default(uuid())
  ticketId       String
  actorId        String
  estadoAnterior TicketStatus?
  estadoNuevo    TicketStatus?
  descripcion    String
  createdAt      DateTime      @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([ticketId])
  @@map("ticket_history")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  ticketId  String?
  type      NotificationType
  mensaje   String
  leida     Boolean          @default(false)
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entidad        String?
  entidadId      String?
  detalle        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([action])
  @@map("audit_logs")
}
