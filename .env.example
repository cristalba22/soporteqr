# ==========================================
# SoporteQR - Variables de entorno (ejemplo)
# Renombrar este archivo a ".env.example" (y copiarlo como ".env" en apps/api).
# Nunca colocar secretos reales en este archivo.
# ==========================================

# --- Base de datos ---
DATABASE_URL="postgresql://soporteqr:soporteqr_dev_password@localhost:5432/soporteqr?schema=public"

# --- Servidor ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- Autenticacion (valores ficticios de desarrollo, generar propios en produccion) ---
JWT_ACCESS_SECRET="dev_access_secret_cambiar_en_produccion_0000000000"
JWT_REFRESH_SECRET="dev_refresh_secret_cambiar_en_produccion_0000000"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
REFRESH_COOKIE_NAME="soporteqr_refresh"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Frontend (apps/web) ---
VITE_API_URL="http://localhost:4000/api"

# --- IA opcional (dejar vacio para usar el fallback local por palabras clave) ---
AI_PROVIDER_API_KEY=""
